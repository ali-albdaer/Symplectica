{
    "name": "@nbody/client",
    "version": "0.1.0",
    "description": "Three.js N-body simulation client",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:demo": "vite build --mode demo",
        "build:ghpages": "vite build --mode ghpages --base=/Symplectica/",
        "preview": "vite preview",
        "preview:demo": "vite preview",
        "preview:ghpages": "vite preview",
        "test": "vitest run",
        "deploy:ghpages": "gh-pages -d dist-ghpages -b gh-pages"
    },
    "dependencies": {
        "three": "^0.172.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.5",
        "@types/three": "^0.172.0",
        "gh-pages": "^6.3.0",
        "typescript": "^5.7.0",
        "vite": "^6.1.0",
        "vitest": "^2.1.8"
    }
}
